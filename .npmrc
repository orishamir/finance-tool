# How npm installs here (guidelines/code.md, "Safety"; docs/architecture.md section 6).
#
# No package runs its own install script. Two installed packages have one, and nothing here needs either:
#   esbuild   its postinstall only checks the binary and swaps its bin/esbuild wrapper for it. tsx (validate, refresh) calls
#             esbuild's JavaScript API, which finds the binary in the platform package npm installs beside it (@esbuild/linux-x64).
#   fsevents  macOS's file watcher, optional and installed on macOS only.
# A package that comes to truly need its script is listed here with why, and rebuilt by name after `npm ci` in every workflow
# (`npm rebuild <name>`).
ignore-scripts=true
# A version is installed only after it has been public for seven days. It acts where npm picks a version (`npm install`,
# `npm update`), from npm 11.10 on; an older npm ignores it without a word. `npm ci` installs the lockfile's versions as they are,
# so the wait is kept when the lockfile changes.
min-release-age=7
