{
  "id": "KH-12",
  "title": "Retirement age for the 3-year route",
  "title_he": "גיל הפרישה למסלול המשיכה המקוצר",
  "text_he": "פקודת מס הכנסה מגדירה את 'גיל הפרישה' בהפניה לחוק גיל פרישה. החוק קובע את גיל הפרישה לגברים ואת גיל הפרישה לנשים, עם לוח של גילים נמוכים יותר לנשים לפי שנת לידה. זה הגיל שהחוק עצמו מכנה 'גיל הפרישה', ולא גיל הפרישה המוקדמת, שהחוק נותן לו שם אחר.",
  "figure_names_he": {
    "retirement_age_men": "גיל הפרישה לגברים",
    "retirement_age_women": "גיל הפרישה לנשים"
  },
  "strength": "primary",
  "dimensions": [
    "age-or-use-exemption",
    "liquidity-lockup"
  ],
  "likely_to_change": "yes",
