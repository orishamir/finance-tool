{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Files, exports and dependencies nothing uses (guidelines/code.md, "Modules"), with the React Router, Vite, Vitest and Playwright
  // plugins. tools/lint.mjs runs it and holds each kind of finding to tools/lint-baseline.json.
  "workspaces": {
    ".": {
      "entry": ["tools/*.{mjs,ts}"],
      "project": ["tools/*.{mjs,ts}", "tests/**/*.ts", "*.ts"],
      "vitest": true,
      "playwright": true
    },
    "site": {
      "entry": ["scripts/**/*.mjs", "app/**/*.test.ts"],
      "project": ["app/**/*.{ts,tsx,css}", "scripts/**/*.mjs", "*.ts"],
      "react-router": true,
      "vite": true
    },
    "packages/*": {
      "entry": ["scripts/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    }
  },
  // the route types React Router writes at typegen (`./+types/<route>`), before the typecheck
  "ignoreUnresolved": ["^\\./\\+types/"],
  // programs tools/library.mjs runs from the machine, not npm packages
  "ignoreBinaries": ["pdfinfo", "pdftotext", "rg"],
  // tools/lint.mjs runs oxlint, which loads oxlint-tsgolint for its type-aware rules
  "ignoreDependencies": ["oxlint", "oxlint-tsgolint"]
}
