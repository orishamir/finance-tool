{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "names": {
      "type": "object",
      "properties": {
        "he": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "en": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "he"
      ],
      "additionalProperties": false
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "flow": {
      "type": "string",
      "minLength": 1
    },
    "series_code": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "enum": [
        "nis",
        "usd",
        "eur",
        "pct",
        "pct_per_year",
        "pct_of_deposit",
        "pct_of_trade",
        "pct_of_balance_per_period",
        "nis_per_month",
        "nis_per_trade",
        "nis_per_transfer",
        "usd_per_share",
        "usd_per_trade",
        "gbp_per_trade",
        "fx_per_eur",
        "months",
        "years",
        "days",
        "business_days",
        "index_points",
        "count",
        "boolean",
        "text"
      ]
    },
    "cadence": {
      "type": "string",
      "enum": [
        "daily",
        "monthly",
        "on change"
      ]
    },
    "stale_after_days": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "terms_of_use": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "unconfirmed",
            "not-permitted"
          ]
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        },
        "terms_url": {
          "type": "string",
          "minLength": 1
        },
        "read_on": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "fallback"
      ],
      "additionalProperties": false
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string",
      "minLength": 1
    },
    "raw": {
      "type": "object",
      "properties": {
        "archive_key": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "archive_key",
        "sha256"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "nis",
              "usd",
              "eur",
              "pct",
              "pct_per_year",
              "pct_of_deposit",
              "pct_of_trade",
              "pct_of_balance_per_period",
              "nis_per_month",
              "nis_per_trade",
              "nis_per_transfer",
              "usd_per_share",
              "usd_per_trade",
              "gbp_per_trade",
              "fx_per_eur",
              "months",
              "years",
              "days",
              "business_days",
              "index_points",
              "count",
              "boolean",
              "text"
            ]
          },
          "source": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "publisher": {
                "type": "string",
                "minLength": 1
              },
              "strength": {
                "type": "string",
                "enum": [
                  "primary",
                  "primary-mirror",
                  "institution",
                  "secondary",
                  "open",
                  "entered"
                ]
              }
            },
            "required": [
              "url",
              "title",
              "publisher",
              "strength"
            ],
            "additionalProperties": false
          },
          "checked": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "effective_from": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_to": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "tax_year": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "update_rule": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "fixed in law",
                  "fixed in regulation",
                  "cpi-linked 1 jan",
                  "average-wage-linked",
                  "provider-set",
                  "market",
                  "founder"
                ]
              },
              {
                "type": "string",
                "pattern": "^frozen \\d{4}-\\d{4}$"
              }
            ]
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "string",
            "enum": [
              "sourced",
              "computed",
              "entered"
            ]
          },
          "computed_from": {
            "type": "object",
            "properties": {
              "formula": {
                "type": "string",
                "pattern": "^[FA]-\\d{2}$"
              },
              "inputs": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "formula",
              "inputs"
            ],
            "additionalProperties": false
          },
          "notes": {
            "type": "string"
          },
          "rationale_he": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "key": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "value",
          "unit",
          "source",
          "checked",
          "effective_from",
          "effective_to",
          "update_rule",
          "state",
          "date"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "names",
    "publisher",
    "flow",
    "series_code",
    "unit",
    "cadence",
    "stale_after_days",
    "terms_of_use",
    "rule_ids",
    "observations"
  ],
  "additionalProperties": false
}
