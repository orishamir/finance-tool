                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tax_year": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "update_rule": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "fixed in law",
                    "fixed in regulation",
                    "fixed in document",
                    "cpi-linked 1 jan",
                    "average-wage-linked",
                    "provider-set",
                    "market",
                    "founder",
                    "set yearly"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^frozen \\d{4}-\\d{4}$"
                }
              ]
            },
            "rule_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "state": {
              "type": "string",
              "enum": [
                "sourced",
                "computed",
                "entered"
              ]
            },
            "computed_from": {
              "type": "object",
