{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9]* OQ\\d+$"
      },
      "status": {
        "type": "string",
        "enum": [
          "open",
          "narrowed"
        ]
      },
      "title_he": {
        "type": "string",
        "minLength": 1
      },
      "blocks_he": {
        "type": "string",
        "minLength": 1
      },
      "answered_by": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[A-Z0-9]+$"
        }
      },
      "meanwhile_he": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "id",
      "status"
    ],
    "additionalProperties": false
  }
}
