{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "he": {
      "type": "string",
      "minLength": 1
    },
    "en": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "meaning": {
      "type": "string",
      "minLength": 1
    },
    "where": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "statement",
          "bank-statement",
          "payslip",
          "app",
          "ad",
          "law",
          "form",
          "bylaws",
          "gemel-net",
          "prospectus",
          "tariff",
          "fund-name",
          "tax-form",
          "pensia-net",
          "provider-site"
        ]
      }
    },
    "wrapper_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "current-account",
          "bank-deposit",
          "savings-plan",
          "money-market-fund-daily",
          "money-market-fund-renewable",
          "makam",
          "government-bond",
          "brokerage-account",
          "kupat-gemel-lehashkaa",
          "keren-hishtalmut",
          "pension-comprehensive",
          "pension-general",
          "provident-for-annuity",
          "child-savings-provident",
          "child-savings-bank",
          "ira-hishtalmut",
          "ira-provident"
        ]
      }
    },
    "exposure_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "type": "string",
          "enum": [
            "primary",
            "primary-mirror",
            "institution",
            "secondary",
            "open",
            "entered"
          ]
        },
        "checked": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "url",
        "title",
        "publisher",
        "strength",
        "checked"
      ],
      "additionalProperties": false
    },
    "seen_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "he",
    "en",
    "meaning",
    "where",
    "wrapper_ids",
    "variants",
    "rule_ids",
    "source"
  ],
  "additionalProperties": false
}
